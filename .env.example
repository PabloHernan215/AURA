# Database - free PostgreSQL from neon.tech (see README for step-by-step setup).
# Format looks like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Geocoding of business addresses (via LocationIQ — free tier, no card required).
# Sign up at locationiq.com and copy the API key from your dashboard. Without it,
# geocoding is skipped and logged as a warning — addresses are saved without
# coordinates, so distance/map features just won't have data to show.
LOCATIONIQ_API_KEY=""

# WhatsApp notifications to professionals when they get a new booking (via Twilio).
# Without these three set, bookings still work fine — the notification is skipped
# and logged as a warning in the server console. See README.md for setup steps.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Email confirmations to client, professional, and admins (via Resend).
# Without these two set, bookings still work fine — email sending is skipped and
# logged as a warning in the server console. See README.md for setup steps.
RESEND_API_KEY=""
EMAIL_FROM="AURA Studio <onboarding@resend.dev>"
