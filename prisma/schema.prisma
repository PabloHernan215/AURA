// AURA — Database Schema
// Uses PostgreSQL (works both locally and in production — see README for setup).
//
// ARCHITECTURE NOTE (migration to venue-centric model):
// The platform is now organized around Business ("Local") as the primary browsable
// entity — like Fresha — instead of individual professionals. A Business has a real
// address and its own approval flow; professionals join an already-approved Business
// instead of registering their own separate location. Clients browse/search Businesses
// first, then pick a professional and service within that business.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: Role and BookingStatus are plain String columns (not native Prisma enums),
// constrained at the application layer to fixed values — see src/types/models.ts.

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CLIENT") // "CLIENT" | "PROFESSIONAL" | "BUSINESS_OWNER" | "ADMIN"
  whatsapp  String   @default("") // used to send booking confirmations via WhatsApp
  isActive  Boolean  @default(true) // admin can disable any user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionalProfile ProfessionalProfile?
  ownedBusiness       Business?            @relation("BusinessOwner")
  bookingsAsClient    Booking[]            @relation("ClientBookings")

  @@map("users")
}

// A physical venue ("Local") — salon, barbershop, spa. This is the primary entity
// clients browse and search. Admin approves each Business once; after that, its
// owner can freely add professionals without per-professional admin review.
model Business {
  id           String  @id @default(cuid())
  ownerId      String  @unique
  owner        User    @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String  @default("")
  location     String?
  latitude     Float?  // auto-filled by geocoding `location` text, used to show real distance to clients
  longitude    Float?
  whatsapp     String  @default("") // business contact number, never shown publicly (see /docs on booking flow)
  photoUrl     String?
  ratingAvg    Float   @default(0)
  ratingCount  Int     @default(0)
  isApproved   Boolean @default(false) // admin must approve before the business appears publicly or can receive bookings
  lastBookingsViewedAt DateTime? // used to compute how many bookings are "new" for the owner's dashboard

  professionals ProfessionalProfile[]
  bookings      Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

model ProfessionalProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bio          String   @default("")
  specialties  String   @default("") // comma-separated for MVP simplicity, e.g. "Cabello,Uñas"
  whatsapp     String   @default("") // personal contact number, used for the professional's own WhatsApp notification
  photoUrl     String?
  ratingAvg    Float    @default(0)
  ratingCount  Int      @default(0)
  lastBookingsViewedAt DateTime? // used to compute how many bookings are "new" since the professional last checked

  services      Service[]
  availability  Availability[]
  bookings      Booking[]      @relation("ProfessionalBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professional_profiles")
}

model Service {
  id             String   @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name           String
  description    String   @default("")
  price          Float
  duration       Int      // minutes
  photoUrl       String?  // photo of finished work, shown in the visual services gallery
  isActive       Boolean  @default(true)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

// Recurring weekly availability window, e.g. Monday 09:00-17:00
model Availability {
  id             String   @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Int      // 0 = Sunday ... 6 = Saturday
  startTime      String   // "HH:mm" 24h
  endTime        String   // "HH:mm" 24h

  createdAt DateTime @default(now())

  @@map("availability")
}

model Booking {
  id             String        @id @default(cuid())
  clientId       String
  client         User          @relation("ClientBookings", fields: [clientId], references: [id])
  businessId     String        // denormalized for fast "all bookings for my venue" queries
  business       Business      @relation(fields: [businessId], references: [id])
  professionalId String
  professional   ProfessionalProfile @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  datetime       DateTime      // start time of the appointment
  durationMin    Int           // snapshot of service duration at booking time
  status         String        @default("PENDING") // "PENDING" | "CONFIRMED" | "CANCELLED" | "COMPLETED"
  notes          String?
  paidOffline    Boolean       @default(false)

  review Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents two active bookings for the same professional at the exact same start time
  // at the database layer -- this is the last line of defense against double-booking races.
  @@unique([professionalId, datetime], name: "professional_datetime_unique")
  @@index([clientId])
  @@index([professionalId, datetime])
  @@index([businessId])
  @@map("bookings")
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@map("reviews")
}

// Single-row table (id is always "settings") holding platform-wide, admin-editable text
// shown in booking confirmation messages, since AURA doesn't process payments in v1.
model PlatformSettings {
  id             String   @id @default("settings")
  paymentMethods String   @default("Efectivo, transferencia bancaria o tarjeta directamente en el estudio.")
  adminBookingsLastViewedAt DateTime? // shared across admins: when the "Reservas" tab was last opened
  updatedAt      DateTime @updatedAt

  @@map("platform_settings")
}
